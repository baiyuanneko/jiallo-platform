# Development image running the Vite dev server with HMR.
#
# The source tree is bind-mounted to /app at runtime (see docker-compose.dev.yml);
# node_modules lives in a named volume initialized from this image on first start.
# If package-lock.json changes, refresh it with:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml exec frontend npm install
FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
